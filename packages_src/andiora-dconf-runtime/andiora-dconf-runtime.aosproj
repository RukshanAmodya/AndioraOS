<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-dconf-runtime</PackageName>
    <PackageVersion>2.0.1-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora dconf runtime profile and dpkg trigger infrastructure</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <Dependency Include="dconf-cli" />
  </ItemGroup>

  <ItemGroup>
    <DpkgTrigger Include="/etc/dconf/db/andiora.d" Type="interest-noawait" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFile Include="assets/user" Target="/etc/dconf/profile/user" />
  </ItemGroup>
</Project>
