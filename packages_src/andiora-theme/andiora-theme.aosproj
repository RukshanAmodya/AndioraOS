<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-theme</PackageName>
    <PackageVersion>2.0.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora complete visual theme — icons, GTK theme, wallpapers, and extensions</PackageDescription>
    <Section>metapackages</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- Theme packages that are essential to the Andiora experience -->
    <Recommend Include="andiora-fluent-icon-theme" />
    <Recommend Include="andiora-fluent-gtk-theme" />

    <!-- The dconf and gnome-shell customization -->
    <Dependency Include="andiora-dconf-defaults" />
    <Recommend Include="andiora-gnome-shell-locale" />

    <!-- User-swappable brand packages -->
    <Recommend Include="andiora-appearance" />
    <Recommend Include="andiora-gnome-extensions" />
    <Recommend Include="plymouth-andiora" />
    <Recommend Include="andiora-wallpapers" />
    <Recommend Include="andiora-gdm3-wallpaper" />
    <Recommend Include="andiora-fonts" />
  </ItemGroup>

</Project>
