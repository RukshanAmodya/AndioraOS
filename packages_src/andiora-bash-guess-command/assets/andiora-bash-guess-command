# shellcheck shell=bash
# Quiet Bash ghost text. Readline remains the only line editor: this loader
# never replaces paste, multiline, Enter, history, or terminal key handling.
[[ $- == *i* ]] || return 0
[[ ${BASH_VERSINFO[0]:-0} -ge 4 ]] || return 0
[[ ${ANDIORA_GUESS_COMMAND:-1} != 0 ]] || return 0
[[ -t 0 && -t 1 ]] || return 0
[[ ${TERM:-dumb} != dumb ]] || return 0
[[ ${_ANDIORA_GUESS_COMMAND_LOADED:-0} != 1 ]] || return 0

_andiora_guess_lib=/usr/lib/andiora-bash-guess-command

# The native module only wraps Readline redisplay, Right Arrow and End. Failure is
# silent and leaves an entirely stock Bash session.
if [[ ${ANDIORA_GUESS_ENGINE:-1} != 0 &&
      -r $_andiora_guess_lib/andiora-ghost.so &&
      -x $_andiora_guess_lib/andiora-quietd ]]; then
    if enable -f "$_andiora_guess_lib/andiora-ghost.so" andiora_ghost \
        2>/dev/null; then
        andiora_ghost configure-history "${HISTFILE-}"
        _andiora_guess_prompt_observe() {
            local _andiora_guess_status=$?
            andiora_ghost observe "$_andiora_guess_status" "$PWD"
            return "$_andiora_guess_status"
        }

        # Run first so $? is the command's real status. Preserve both Bash's
        # array form and the traditional string form of PROMPT_COMMAND.
        if [[ ${PROMPT_COMMAND@a} == *a* ]]; then
            _andiora_guess_seen=0
            for _andiora_guess_item in "${PROMPT_COMMAND[@]}"; do
                if [[ $_andiora_guess_item == _andiora_guess_prompt_observe ]]; then
                    _andiora_guess_seen=1
                    break
                fi
            done
            if (( !_andiora_guess_seen )); then
                PROMPT_COMMAND=(_andiora_guess_prompt_observe "${PROMPT_COMMAND[@]}")
            fi
        elif [[ ${PROMPT_COMMAND-} ]]; then
            if [[ ";${PROMPT_COMMAND// /};" != *";_andiora_guess_prompt_observe;"* ]]; then
                PROMPT_COMMAND="_andiora_guess_prompt_observe; $PROMPT_COMMAND"
            fi
        else
            PROMPT_COMMAND=_andiora_guess_prompt_observe
        fi
        _ANDIORA_GUESS_COMMAND_LOADED=1
        unset _andiora_guess_seen _andiora_guess_item
    fi
fi

unset _andiora_guess_lib
