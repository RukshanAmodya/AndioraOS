<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>gnome-shell-extension-clipboard-indicator</PackageName>
    <PackageVersion>2.0.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>The most popular clipboard manager for GNOME, with over 1M downloads — packaged for Andiora</PackageDescription>
    <Section>gnome</Section>
    <PackageHomepage>https://extensions.gnome.org/extension/779/</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>
  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="andiora-dconf-runtime" />
    <Dependency Include="gnome-shell" />
    <Dependency Include="dconf-gsettings-backend | gsettings-backend" />
    <Dependency Include="gir1.2-adw-1" />
    <Dependency Include="gir1.2-gtk-4.0" />
    <Recommend Include="gnome-shell-extension-prefs | gnome-shell-extension-manager" />
    <IncludeFolder Include="deploy/noble/clipboard-indicator@tudmotu.com"
                   Target="/usr/share/gnome-shell/extensions/clipboard-indicator@tudmotu.com"
                   Condition="'$(Suite)' == 'noble-addon'" />
                   Target="/usr/share/gnome-shell/extensions/clipboard-indicator@tudmotu.com"
    <IncludeFolder Include="deploy/resolute/clipboard-indicator@tudmotu.com"
                   Target="/usr/share/gnome-shell/extensions/clipboard-indicator@tudmotu.com"
                   Condition="'$(Suite)' == 'resolute-addon'" />
  </ItemGroup>
  <ItemGroup>
    <PrebuildCommand Run="bash download.sh" />
  </ItemGroup>
  <ItemGroup>
    <IncludeFile Include="dconf/12-clipboard-indicator.conf" Target="/etc/dconf/db/andiora.d/12-clipboard-indicator.conf" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
