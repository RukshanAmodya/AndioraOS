<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-appstore</PackageName>
    <PackageVersion>2.0.0-3+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora app store metapackage — GNOME Software with Flatpak support. Install this if you want a graphical app store and Flatpak sandboxed applications.</PackageDescription>
    <Section>metapackages</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <Recommend Include="flatpak" />
    <Recommend Include="gnome-software" />
    <Recommend Include="gnome-software-plugin-flatpak" />
    <Recommend Include="gnome-software-plugin-fwupd" Condition="'$(Suite)' == 'resolute-addon'" />
    <Recommend Include="flatseal" Condition="'$(Suite)' == 'resolute-addon'" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />
  </ItemGroup>
</Project>
