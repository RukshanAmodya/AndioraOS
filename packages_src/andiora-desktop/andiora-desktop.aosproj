<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-desktop</PackageName>
    <PackageVersion>2.0.1-5+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora complete desktop — metapackage that pulls in all Andiora components</PackageDescription>
    <Section>metapackages</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <Provides>yaru-theme-gnome-shell</Provides>
    <Conflicts>yaru-theme-gnome-shell, update-notifier, update-notifier-common, update-manager, update-manager-core, ubuntu-release-upgrader-core, ubuntu-release-upgrader-gtk, ubuntu-desktop, whoopsie</Conflicts>
    <Replaces>yaru-theme-gnome-shell, update-notifier, update-notifier-common, update-manager, update-manager-core, ubuntu-release-upgrader-core, ubuntu-release-upgrader-gtk, ubuntu-desktop, whoopsie</Replaces>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- ============================================================
         Layer 2 — Desktop Core (GNOME foundation, no branding)
         Pulls in andiora-core-system via its own dependency chain.
         ============================================================ -->
    <Dependency Include="andiora-desktop-core" />

    <!-- ============================================================
         Andiora Brand Packages
         These define what makes Andiora Andiora.
         ============================================================ -->
    <Dependency Include="andiora-apt-config | andiora-apt-config-dev" />
    <Recommend Include="andiora-apt-config" />
    <Dependency Include="base-files" />
    <Dependency Include="andiora-no-snapd" />
    <Recommend Include="andiora-kernel-parameters" Condition="'$(Suite)' == 'resolute-addon'" />

    <!-- Zram swap (compressed RAM) — 50% RAM, lz4. User can override via swapcontrol-gtk. -->
    <Recommend Include="andiora-swap-config" />

    <!-- These are the "core" brand packages that are essential to the Andiora experience. -->
    <Recommend Include="andiora-deskmon" />
    <Recommend Include="andiora-theme-sync" />
    <Recommend Include="andiora-templates" />
    <!-- Brand packages the user may want to swap or remove -->
    <Recommend Include="andiora-software-properties-common" />

    <!-- Default Applications -->
    <Recommend Include="andiora-desktop-apps" />

    <!-- App Store -->
    <Recommend Include="andiora-appstore" />

    <!-- Theme (plymouth comes transitively via-andiora-theme) -->
    <Recommend Include="andiora-theme" />
  </ItemGroup>
</Project>
