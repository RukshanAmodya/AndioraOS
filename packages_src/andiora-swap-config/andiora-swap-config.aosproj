<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-swap-config</PackageName>
    <PackageVersion>2.0.1-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora Swap default configuration — enables 50%-of-RAM lz4 zram and swappiness=100 on boot. Zswap support is installed but remains opt-in via the GUI. Services are installed to /usr/lib/systemd/system/ so andiora-swapcontrol-gtk controls them via declarative config files without dpkg conflicts.</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
    <Provides>andiora-zram-config</Provides>
    <Replaces>andiora-zram-config</Replaces>
    <Conflicts>andiora-zram-config</Conflicts>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal dependencies: just util-linux for zramctl, mkswap, swapon -->
    <Dependency Include="util-linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zram service: creates compressed RAM swap devices at boot.
         Installed to /usr/lib (vendor default) — the GUI controls behavior
         by writing /etc/default/andiora-zram, never by overriding this unit. -->
    <!-- SystemdUnit: auto-generates postinst (systemctl preset → enable) + prerm (stop) + postrm (disable) -->
    <SystemdUnit Include="data/andiora-zram.service" AutoEnable="true" UsePreset="true" />
    <!-- Zswap service: configures kernel zswap parameters when the user enables it.
         Same config-driven pattern: GUI writes /etc/default/andiora-zswap. -->
    <SystemdUnit Include="data/andiora-zswap.service" AutoEnable="false" />
    <!-- Preset enables zram by default; zswap stays opt-in -->
    <IncludeFile Include="data/90-andiora-swap.preset" Target="/usr/lib/systemd/system-preset/90-andiora-swap.preset" />
    <IncludeFile Include="data/setup-zram.sh" Target="/usr/lib/andiora-swap-config/setup-zram.sh" Mode="755" />
    <IncludeFile Include="data/setup-zswap.sh" Target="/usr/lib/andiora-swap-config/setup-zswap.sh" Mode="755" />
    <!-- Sysctl optimized for zram: swappiness=100 prefers fast LZ4-compressed RAM over
         dropping file cache; page-cluster=0 disables swap readahead (useless for RAM).
         Installed as 30- so it overrides 20-andiora-tweaks.conf from system-tweaks. -->
    <IncludeFile Include="data/30-andiora-swap.conf" Target="/etc/sysctl.d/30-andiora-swap.conf" />
    <!-- Reload sysctl after install so swappiness=100 takes effect immediately -->
    <PostInstallScript Include="scripts/postinst.sh" />
    <!-- Reload sysctl after removal: falls back to system-tweaks (swappiness=10)
         or kernel default (60) if system-tweaks is also removed -->
    <PostRemoveScript Include="scripts/postrm.sh" />
  </ItemGroup>
</Project>
