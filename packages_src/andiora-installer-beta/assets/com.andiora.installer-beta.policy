<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Andiora</vendor>
  <vendor_url>https://www.andiora.com</vendor_url>

  <action id="com.andiora.installer-beta.probe-storage">
    <description>Read exact disk partition geometry for the Andiora installer</description>
    <message>Authorization is required to inspect disk partition geometry</message>
    <icon_name>drive-harddisk-symbolic</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/andiora-installer-storage-probe</annotate>
  </action>
</policyconfig>
