<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-archive-keyring</PackageName>
    <PackageVersion>2.0.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>GPG keyring for Andiora APT repository</PackageDescription>
    <Section>misc</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <PrebuildCommand Run="mkdir -p deploy &amp;&amp; curl -sL https://packages.andiora.com/artifacts/certs/andiora | sed '1s/^\xEF\xBB\xBF//' | gpg --dearmor > deploy/andiora-archive-keyring.gpg" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFile Include="deploy/andiora-archive-keyring.gpg" Target="/usr/share/keyrings/andiora-archive-keyring.gpg" />
  </ItemGroup>
</Project>
