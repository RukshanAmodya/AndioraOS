#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:83
msgid ""
"Secure Boot is a motherboard security standard that ensures only trusted "
"software loads at startup."
msgstr ""
"\tΤο Secure Boot είναι ένα πρότυπο ασφαλείας της μητρικής πλακέτας που "
"διασφαλίζει ότι μόνο αξιόπιστο λογισμικό φορτώνεται κατά την εκκίνηση."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:86
msgid "It protects your system from low-level malware and rootkits."
msgstr ""
"Προστατεύει το σύστημά σας από κακόβουλο λογισμικό χαμηλού επιπέδου και "
"rootkits."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:95
msgid "System Trust Status"
msgstr "Κατάσταση Εμπιστοσύνης Συστήματος"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:132
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:274
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:406
msgid "Create & Enroll Certificate"
msgstr "Δημιουργία & Εγγραφή Πιστοποιητικού"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:138
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:284
msgid "Repair Module Signatures"
msgstr "Υπογραφές μονάδας επισκευής"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:146
msgid "Note: Use password <b>123456</b> after rebooting."
msgstr ""
"Σημείωση: Χρησιμοποιήστε τον κωδικό <b>123456</b> μετά την επανεκκίνηση."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:151
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:392
msgid "Reboot & Configure Secure Boot"
msgstr "Επανεκκίνηση & Διαμόρφωση Secure Boot"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:159
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:358
msgid "  Check Again  "
msgstr "  Επανέλεγχος  "

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:185
msgid "Motherboard hardware protection is active"
msgstr "Η προστασία υλικού της μητρικής πλακέτας είναι ενεργή"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:188
msgid "Firmware does not support Secure Boot"
msgstr ""
"Το υλικολογισμικό δεν υποστηρίζει το Secure Boot\n"
"Η κατάσταση "

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:194
msgid "Secure Boot is disabled"
msgstr "Το Secure Boot είναι απενεργοποιημένο"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:200
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:202
msgid "Not required without firmware enforcement"
msgstr "Δεν απαιτείται χωρίς επιβολή υλικολογισμικού"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:206
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:210
msgid "Not checked because Secure Boot state is unknown"
msgstr "Δεν ελέγχθηκε επειδή η κατάσταση Secure Boot είναι άγνωστη"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:215
msgid "Certificate generated locally"
msgstr "Το πιστοποιητικό δημιουργήθηκε τοπικά"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:217
msgid "Missing local certificate"
msgstr "Λείπει τοπικό πιστοποιητικό"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:230
msgid "Certificate is trusted by motherboard"
msgstr "Το πιστοποιητικό εμπιστεύεται η μητρική πλακέτα"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:245
msgid "Kernel signature enforcement is inactive"
msgstr "Η επιβολή υπογραφής πυρήνα είναι ανενεργή"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:248
msgid "Driver trust cannot be verified"
msgstr ""
"Δεν είναι δυνατή η επαλήθευση της εμπιστοσύνης του προγράμματος οδήγησης"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:252
msgid ""
"Secure Boot trust is ready. No third-party kernel modules are currently "
"installed."
msgstr ""
"Το αξιόπιστο Secure Boot είναι έτοιμο. Δεν υπάρχουν επί του παρόντος "
"εγκατεστημένες λειτουργικές μονάδες πυρήνα τρίτου μέρους."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:256
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:447
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:455
msgid "Drivers are signed and ready to load"
msgstr "Οι οδηγοί είναι υπογεγραμμένοι και έτοιμοι για φόρτωση"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:260
msgid "Drivers are trusted, but automatic DKMS signing needs repair"
msgstr ""
"Τα προγράμματα οδήγησης είναι αξιόπιστα, αλλά η αυτόματη υπογραφή DKMS "
"χρειάζεται επισκευή"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:264
msgid "No signed third-party drivers detected"
msgstr "Δεν εντοπίστηκαν υπογεγραμμένοι οδηγοί τρίτων"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:272
msgid "Enroll Existing Certificate"
msgstr "Εγγραφή υπάρχοντος πιστοποιητικού"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:282
msgid "Repair Automatic DKMS Signing"
msgstr "Επισκευή αυτόματης υπογραφής DKMS"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:299
msgid "This firmware does not provide Secure Boot. No certificate is required."
msgstr ""
"Αυτό το υλικολογισμικό δεν παρέχει Secure Boot. Δεν απαιτείται πιστοποιητικό."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:306
msgid ""
"Secure Boot status could not be read. Driver trust operations are blocked "
"until detection succeeds."
msgstr ""
"Δεν ήταν δυνατή η ανάγνωση της κατάστασης Secure Boot. Οι λειτουργίες "
"αξιοπιστίας προγραμμάτων οδήγησης μπλοκάρονται μέχρι να επιτύχει ο "
"εντοπισμός."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:311
msgid "No certificate is required while Secure Boot is disabled."
msgstr ""
"Δεν απαιτείται πιστοποιητικό όταν το Secure Boot είναι απενεργοποιημένο."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:314
msgid "System Trust Established. Third-party drivers will load securely."
msgstr ""
"Ιδρύθηκε Εμπιστοσύνη Συστήματος. Οι οδηγοί τρίτων θα φορτωθούν με ασφάλεια."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:318
msgid "The certificate is enrolled and current drivers are trusted."
msgstr ""
"Το πιστοποιητικό έχει εγγραφεί και τα τρέχοντα προγράμματα οδήγησης είναι "
"αξιόπιστα."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:320
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"Επισκευάστε την αυτόματη υπογραφή DKMS πριν από μελλοντικές ενημερώσεις "
"προγραμμάτων οδήγησης."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:325
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr ""
"Το πιστοποιητικό έχει εγγραφεί, αλλά ορισμένες ενότητες δεν έχουν υπογραφεί "
"με αυτό."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:330
msgid "A certificate is waiting for enrollment."
msgstr "Ένα πιστοποιητικό περιμένει για εγγραφή."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:332
msgid "Restart and enter password 123456 in MOKManager."
msgstr ""
"Κάντε επανεκκίνηση και εισαγάγετε τον κωδικό πρόσβασης 123456 στο MOKManager."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:337
msgid "The local trust certificate is not yet enrolled."
msgstr "Το πιστοποιητικό τοπικής εμπιστοσύνης δεν έχει εγγραφεί ακόμη."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:339
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:346
msgid "You must configure this to use third-party drivers like NVIDIA."
msgstr ""
"Πρέπει να το διαμορφώσετε για να χρησιμοποιήσετε οδηγούς τρίτων όπως ο "
"NVIDIA."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:344
msgid "The local trust certificate is missing."
msgstr "Το πιστοποιητικό τοπικής εμπιστοσύνης λείπει."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:362
msgid "  Checking...  "
msgstr "  Έλεγχος...  "

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:368
msgid "Reboot Required"
msgstr "Απαιτείται Επανεκκίνηση"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:369
msgid "Please trust the certificate upon reboot using password 123456."
msgstr ""
"Παρακαλώ εμπιστευτείτε το πιστοποιητικό κατά την επανεκκίνηση "
"χρησιμοποιώντας τον κωδικό 123456."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:371
msgid "Cancel"
msgstr "Ακύρωση"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:372
msgid "Reboot"
msgstr "Επανεκκίνηση"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:380
msgid "Success! When you reboot, a blue screen will appear."
msgstr "Επιτυχία! Όταν κάνετε επανεκκίνηση, θα εμφανιστεί μια μπλε οθόνη."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:384
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr ""
"Επιλέξτε 'Enroll MOK' → 'Συνέχεια' → 'Ναι', και εισάγετε κωδικό: 123456"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:388
msgid "Certificate Created"
msgstr "Δημιουργήθηκε Πιστοποιητικό"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:391
msgid "Later"
msgstr "Αργότερα"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:420
msgid "Secure Boot Trust Not Required"
msgstr "Secure Boot Δεν απαιτείται εμπιστοσύνη"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:421
msgid "Firmware signature enforcement is not active."
msgstr "Η επιβολή υπογραφής υλικολογισμικού δεν είναι ενεργή."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:431
msgid ""
"The certificate is ready, but one or more DKMS modules could not be rebuilt. "
"You can repair them after enrollment."
msgstr ""
"Το πιστοποιητικό είναι έτοιμο, αλλά μία ή περισσότερες μονάδες DKMS δεν ήταν "
"δυνατό να αναδημιουργηθούν. Μπορείτε να τα επισκευάσετε μετά την εγγραφή σας."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:439
msgid "Configuration needs attention"
msgstr "Η διαμόρφωση χρειάζεται προσοχή"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:446
msgid "System Trust Established"
msgstr "Ιδρύθηκε η εμπιστοσύνη συστήματος"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:454
msgid "Driver Signature Trusted"
msgstr "Αξιόπιστο Ψηφιακό Υπογραφής Οδηγού"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:470
msgid "Configuration failed. Please try again."
msgstr "Η διαμόρφωση απέτυχε. Παρακαλώ δοκιμάστε ξανά."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:471
msgid "Please check the advanced output."
msgstr "Παρακαλώ ελέγξτε τις προηγμένες εξόδους."

