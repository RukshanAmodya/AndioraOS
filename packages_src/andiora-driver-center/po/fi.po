#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:210
msgid "Not checked because Secure Boot state is unknown"
msgstr "Ei valittu, koska Secure Boot-tila on tuntematon"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:215
msgid "Certificate generated locally"
msgstr "Sertifikaatti luotu paikallisesti"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:217
msgid "Missing local certificate"
msgstr "Puuttuva paikallinen sertifikaatti"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:230
msgid "Certificate is trusted by motherboard"
msgstr "Emolevyn laitteisto luottaa sertifikaattiin"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:245
msgid "Kernel signature enforcement is inactive"
msgstr "Ytimen allekirjoituksen valvonta ei ole aktiivinen"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:248
msgid "Driver trust cannot be verified"
msgstr "Ohjaimen luottamusta ei voida varmistaa"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:252
msgid ""
"Secure Boot trust is ready. No third-party kernel modules are currently "
"installed."
msgstr ""
"Secure Boot luottamus on valmis. Kolmannen osapuolen ydinmoduuleja ei ole "
"tällä hetkellä asennettu."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:256
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:447
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:455
msgid "Drivers are signed and ready to load"
msgstr "Ajurit on allekirjoitettu ja valmiina ladattavaksi"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:260
msgid "Drivers are trusted, but automatic DKMS signing needs repair"
msgstr ""
"Ohjaimet ovat luotettavia, mutta automaattinen DKMS-allekirjoitus vaatii "
"korjausta"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:264
msgid "No signed third-party drivers detected"
msgstr "Ei allekirjoitettuja kolmannen osapuolen ajureita havaittu"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:272
msgid "Enroll Existing Certificate"
msgstr "Rekisteröi olemassa oleva sertifikaatti"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:282
msgid "Repair Automatic DKMS Signing"
msgstr "Korjaa automaattinen DKMS allekirjoitus"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:299
msgid "This firmware does not provide Secure Boot. No certificate is required."
msgstr "Tämä laiteohjelmisto ei tarjoa Secure Boot:tä. Varmennetta ei vaadita."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:306
msgid ""
"Secure Boot status could not be read. Driver trust operations are blocked "
"until detection succeeds."
msgstr ""
"Secure Boot-tilaa ei voitu lukea. Ohjaimen luottamustoiminnot estetään, "
"kunnes tunnistus onnistuu."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:311
msgid "No certificate is required while Secure Boot is disabled."
msgstr "Varmennetta ei vaadita, kun Secure Boot on poistettu käytöstä."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:314
msgid "System Trust Established. Third-party drivers will load securely."
msgstr ""
"Järjestelmän luottamus vakiintunut. Kolmannen osapuolen ajurit latautuvat "
"turvallisesti."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:318
msgid "The certificate is enrolled and current drivers are trusted."
msgstr "Varmenne on rekisteröity ja nykyiset ohjaimet ovat luotettavia."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:320
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"Korjaa automaattinen DKMS-allekirjoitus ennen tulevia ohjainpäivityksiä."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:325
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr ""
"Varmenne on rekisteröity, mutta joitain moduuleja ei ole allekirjoitettu "
"sillä."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:330
msgid "A certificate is waiting for enrollment."
msgstr "Varmenne odottaa rekisteröintiä."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:332
msgid "Restart and enter password 123456 in MOKManager."
msgstr "Käynnistä uudelleen ja kirjoita salasana 123456 kohtaan MOKManager."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:337
msgid "The local trust certificate is not yet enrolled."
msgstr "Paikallista luottamussertifikaattia ei ole vielä rekisteröity."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:339
#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:346
msgid "You must configure this to use third-party drivers like NVIDIA."
msgstr ""
"Sinun on määritettävä tämä käyttääksesi kolmannen osapuolen ajureita kuten "
"NVIDIA."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:344
msgid "The local trust certificate is missing."
msgstr "Paikallinen luottamussertifikaatti puuttuu."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:362
msgid "  Checking...  "
msgstr "  Tarkistetaan...  "

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:368
msgid "Reboot Required"
msgstr "Uudelleenkäynnistys vaaditaan"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:369
msgid "Please trust the certificate upon reboot using password 123456."
msgstr ""
"Luota sertifikaattiin uudelleenkäynnistyksen yhteydessä käyttämällä "
"salasanaa 123456."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:371
msgid "Cancel"
msgstr "Peruuta"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:372
msgid "Reboot"
msgstr "Uudelleenkäynnistys"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:380
msgid "Success! When you reboot, a blue screen will appear."
msgstr "Onnistui! Kun uudelleenkäynnistät, sininen ruutu ilmestyy."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:384
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr ""
"Valitse 'Rekisteröi MOK' → 'Jatka' → 'Kyllä', ja syötä salasana: 123456"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:388
msgid "Certificate Created"
msgstr "Sertifikaatti luotu"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:391
msgid "Later"
msgstr "Myöhemmin"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:420
msgid "Secure Boot Trust Not Required"
msgstr "Secure Boot Luottamusta ei vaadita"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:421
msgid "Firmware signature enforcement is not active."
msgstr "Laiteohjelmiston allekirjoituksen valvonta ei ole aktiivinen."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:431
msgid ""
"The certificate is ready, but one or more DKMS modules could not be rebuilt. "
"You can repair them after enrollment."
msgstr ""
"Varmenne on valmis, mutta yhtä tai useampaa DKMS-moduulia ei voitu rakentaa "
"uudelleen. Voit korjata ne ilmoittautumisen jälkeen."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:439
msgid "Configuration needs attention"
msgstr "Kokoonpano vaatii huomiota"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:446
msgid "System Trust Established"
msgstr "Järjestelmän luottamus perustettu"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:454
msgid "Driver Signature Trusted"
msgstr "Ajamin allekirjoituksen luotettu"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:470
msgid "Configuration failed. Please try again."
msgstr "Määritys epäonnistui. Yritä uudelleen."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:471
msgid "Please check the advanced output."
msgstr "Tarkista lisätulosteet."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:482
msgid "Generating & Signing..."
msgstr "Luodaan ja allekirjoitetaan..."

