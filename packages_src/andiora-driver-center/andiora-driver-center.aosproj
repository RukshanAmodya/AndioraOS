<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-driver-center</PackageName>
    <PackageVersion>2.0.0-8+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora Driver Center — inspect and manage graphics, audio, printer, Xbox controller, and Secure Boot driver support.</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>Andiora Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="python3" />
    <Dependency Include="python3-gi" />
    <Dependency Include="gir1.2-gtk-4.0" />
    <Dependency Include="gir1.2-adw-1" />
    <Dependency Include="ubuntu-drivers-common" />
    <Dependency Include="andiora-secureboot-toolkit" />
    <Dependency Include="pkexec" />
    <Dependency Include="pciutils" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="scripts/andiora-driver-center" Target="/usr/bin/andiora-driver-center" />
    <IncludeScript Include="scripts/driver-helper" Target="/usr/libexec/andiora-driver-center/driver-helper" />
    <IncludeFile Include="src/andiora_driver_center/__init__.py" Target="/usr/lib/python3/dist-packages/andiora_driver_center/__init__.py" />
    <IncludeFile Include="src/andiora_driver_center/__main__.py" Target="/usr/lib/python3/dist-packages/andiora_driver_center/__main__.py" />
    <IncludeFile Include="src/andiora_driver_center/app.py" Target="/usr/lib/python3/dist-packages/andiora_driver_center/app.py" />
    <IncludeFile Include="src/andiora_driver_center/core.py" Target="/usr/lib/python3/dist-packages/andiora_driver_center/core.py" />
    <IncludeFolder Include="resources" Target="/usr/share/andiora-driver-center/illustrations" />
    <IncludeFile Include="data/com.andiora.DriverCenter.policy" Target="/usr/share/polkit-1/actions/com.andiora.DriverCenter.policy" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/com.andiora.DriverCenter.desktop" Icon="data/com.andiora.DriverCenter.svg" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash compile-locales.sh" />
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v" />
  </ItemGroup>
</Project>
