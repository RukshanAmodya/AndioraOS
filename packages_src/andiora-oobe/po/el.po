msgid "Fastest Mirror Found"
msgstr "Γρήγορος Καθρέφτης Βρέθηκε"

#: andiora-oobe/assets/andiora-oobe:1897
msgid "Keep Current"
msgstr "Διατήρηση Τρέχοντος"

#: andiora-oobe/assets/andiora-oobe:1898
msgid "Switch"
msgstr "Εναλλαγή"

#: andiora-oobe/assets/andiora-oobe:1920
