msgid "Best mirror by bandwidth"
msgstr "Καλύτερος καθρέφτης βάσει εύρους ζώνης"

#: andiora-oobe/assets/andiora-oobe:1852
#: andiora-oobe/assets/andiora-oobe:1873
#: andiora-oobe/assets/andiora-oobe:1880
msgid "Latency"
msgstr "Καθυστέρηση"

#: andiora-oobe/assets/andiora-oobe:1853
#: andiora-oobe/assets/andiora-oobe:1874
#: andiora-oobe/assets/andiora-oobe:1881
msgid "Bandwidth"
msgstr "Εύρος Ζώνης"

