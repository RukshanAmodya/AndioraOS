msgid ""
"Secure Boot status could not be read. Driver trust operations are blocked "
"until detection succeeds."
msgstr ""
"Nie można odczytać statusu Secure Boot. Operacje zaufania sterowników są "
"blokowane do momentu pomyślnego wykrycia."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:311
msgid "No certificate is required while Secure Boot is disabled."
msgstr "Żaden certyfikat nie jest wymagany, gdy Secure Boot jest wyłączony."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:314
msgid "System Trust Established. Third-party drivers will load securely."
msgstr ""
"\\\tZaufanie systemowe ustanowione. Sterowniki firm trzecich będą ładowane "
"bezpiecznie."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:318
msgid "The certificate is enrolled and current drivers are trusted."
msgstr "Certyfikat został zarejestrowany, a aktualne sterowniki są zaufane."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:320
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"Napraw automatyczne podpisywanie DKMS przed przyszłymi aktualizacjami "
"sterowników."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:325
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr ""
"Certyfikat jest zarejestrowany, ale niektóre moduły nie są nim podpisane."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:330
msgid "A certificate is waiting for enrollment."
msgstr "Certyfikat oczekuje na rejestrację."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:332
msgid "Restart and enter password 123456 in MOKManager."
msgstr "Uruchom ponownie i wprowadź hasło 123456 w MOKManager."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:337
msgid "The local trust certificate is not yet enrolled."
msgstr "Lokalny certyfikat zaufania nie został jeszcze zarejestrowany."

