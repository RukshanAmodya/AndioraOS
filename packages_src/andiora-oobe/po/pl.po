msgid "The local trust certificate is missing."
msgstr "Brak lokalnego certyfikatu zaufania."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:362
msgid "  Checking...  "
msgstr "  Sprawdzanie...  "

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:368
msgid "Reboot Required"
msgstr "\\\tWymagany restart"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:369
msgid "Please trust the certificate upon reboot using password 123456."
msgstr ""
"\\\tZaufaj certyfikatowi po ponownym uruchomieniu, używając hasła 123456."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:371
msgid "Cancel"
msgstr "\\\tAnuluj"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:372
msgid "Reboot"
msgstr "\\\tRestart"

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:380
msgid "Success! When you reboot, a blue screen will appear."
msgstr "\\\tSukces! Po restarcie pojawi się niebieski ekran."

#: andiora-secureboot-toolkit/src/andiora_secureboot/ui.py:384
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr "\\\tWybierz 'Enroll MOK' → 'Continue' → 'Yes' i wpisz hasło: 123456"

