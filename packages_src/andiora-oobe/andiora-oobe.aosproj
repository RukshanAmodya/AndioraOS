<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>andiora-oobe</PackageName>
    <PackageVersion>2.0.1-21+$(SuiteShortName)</PackageVersion>
    <Maintainer>Andiora Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Andiora OOBE — First-run setup wizard and Welcome Center</PackageDescription>
    <Section>utils</Section>
    <PackageHomepage>https://www.andiora.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/Andiora-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>Andiora Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>andiora</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="python3" />
    <Dependency Include="python3-gi" />
    <Dependency Include="gir1.2-gtk-4.0" />
    <Dependency Include="gir1.2-adw-1" />
    <Dependency Include="dconf-cli" />
    <Dependency Include="ufw" />
    <Dependency Include="flatpak" />
    <Dependency Include="pkexec" />
    <Dependency Include="andiora-appearance (&gt;= 2.0.1-5)" />
    <Dependency Include="network-manager" />
    <Dependency Include="andiora-secureboot-toolkit" />
    <Dependency Include="andiora-driver-center (&gt;= 2.0.0-8)" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="assets/andiora-oobe" Target="/usr/bin/andiora-oobe" />
    <IncludeFile Include="assets/andiora-oobe-autostart.desktop" Target="/etc/xdg/autostart/andiora-oobe.desktop" />
    <IncludeFolder Include="resources/icons" Target="/usr/share/andiora-oobe/icons" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
    <IncludeScript Include="scripts/network-service-helper" Target="/usr/libexec/andiora-oobe/network-service-helper" />
    <IncludeFile Include="data/com.andiora.oobe.policy" Target="/usr/share/polkit-1/actions/com.andiora.oobe.policy" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/andiora-oobe.desktop" Icon="data/andiora-oobe.svg" />
    <AppStreamScreenshot Include="screenshots/welcome.png" Default="true" Caption="Welcome home to Andiora" Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/visual-setup.png" Caption="Personalize the desktop during first-run setup" Environment="GNOME:dark" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="python3 -m py_compile assets/andiora-oobe" />
    <PrebuildCommand Run="LANGUAGE=C PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v" />
    <PrebuildCommand Run="bash compile-locales.sh" />
  </ItemGroup>
</Project>
